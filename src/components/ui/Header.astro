---
/**
 * Header — the site header bar.
 * Three zones: the wordmark on the left, the nav links centered, then the
 * course meta and partner logo on the right. `justify-between` splits the
 * leftover space equally on either side of the nav, so it reads as evenly
 * spaced between the wordmark and the meta — the perceptual centre. The
 * geometric centre of the bar would sit noticeably right of that, because
 * the meta-and-logo zone is far wider than the wordmark.
 * Below `sm` the nav drops to its own full-width row underneath.
 */
import { Image } from 'astro:assets';
import cornellTechLogo from '@assets/logos/cornell-tech.png';
import { baseUrl, withBase } from '@lib/base';

const currentPath = Astro.url.pathname;

const navItems = [{ name: 'Readings', url: withBase('readings/') }];

const isActive = (url: string) => {
  const path = new URL(url, 'http://localhost').pathname;
  return currentPath === path || currentPath.startsWith(path);
};
---

<header class='border-b border-skin-line bg-skin-fill'>
  <div
    class='mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-4 sm:px-6'
  >
    <a href={baseUrl} class='header-wordmark'>Urban Systems</a>
    <!-- -ml-2 cancels the nav link's own padding so the mobile row lines up
         with the wordmark; centred at sm and up, the padding is symmetric
         and needs no correction. -->
    <nav
      aria-label='Site'
      class='order-last -ml-2 w-full sm:order-none sm:ml-0 sm:w-auto'
    >
      <ul class='header-nav sm:justify-center'>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.url}
                class:list={[
                  'header-nav-link',
                  { 'header-nav-link--active': isActive(item.url) },
                ]}
                aria-current={isActive(item.url) ? 'page' : undefined}
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class='flex flex-wrap items-center justify-end gap-x-4 gap-y-2'>
      <span class='header-meta'>INFO 5410 · Cornell Tech</span>
      <Image
        src={cornellTechLogo}
        alt='Cornell Tech'
        class='partner-logo'
        loading='lazy'
      />
    </div>
  </div>
</header>

<style>
  .header-wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
    color: rgb(var(--color-text-base));
    text-decoration: none;
    transition: var(--theme-transition);
  }

  .header-wordmark:hover {
    color: rgb(var(--color-accent));
  }

  .header-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .header-nav-link {
    font-family: var(--font-body);
    font-weight: 500;
    color: rgb(var(--color-text-base));
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    transition: var(--theme-transition);
  }

  .header-nav-link:hover,
  .header-nav-link:focus-visible {
    color: rgb(var(--color-accent));
  }

  .header-nav-link--active {
    font-weight: 700;
  }

  .header-meta {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.875rem;
    color: rgb(var(--color-text-base));
    opacity: 0.75;
  }

  /* The logo asset is the white reversed variant.
     In the light theme it is inverted to dark ink.
     In the dark theme it stays white. */
  .partner-logo {
    height: 26px;
    width: auto;
    filter: invert(1);
    transition: var(--theme-transition);
  }

  :global(html[data-theme='dark']) .partner-logo {
    filter: none;
  }
</style>
