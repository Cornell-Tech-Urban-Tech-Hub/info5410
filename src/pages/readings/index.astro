---
/**
 * Readings index. Lists every reading in the collection, grouped by
 * syllabus week. Readings with an OCR-ed text store link to the
 * on-site reader. See wiki/readings.md.
 */
import Default from '@layouts/Default.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import DashedLink from '@components/ui/DashedLink.astro';
import { withBase } from '@lib/base';
import { getCollection } from 'astro:content';

const readings = (await getCollection('readings')).sort((a, b) => {
  const weekDiff = (a.data.week ?? 99) - (b.data.week ?? 99);
  if (weekDiff !== 0) return weekDiff;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const weeks = [...new Set(readings.map((reading) => reading.data.week))];

const hasText = (body: string | undefined) =>
  body !== undefined && body.trim().length > 0;
---

<Default
  title='Readings, INFO 5410: Urban Systems, Cornell Tech'
  description='Course readings for INFO 5410: Urban Systems, Cornell Tech, Fall 2026.'
>
  <main class='mx-auto w-full max-w-6xl flex-1 px-6 pb-16'>
    <section class='home-section max-w-3xl pt-12'>
      <SectionHeading id='readings-heading'>Readings</SectionHeading>
      <p class='page-copy'>
        Readings for the semester, by syllabus week. Each entry links to the
        source material. Readings with an on-site text store open in the
        built-in reader.
      </p>

      {
        weeks.map((week) => (
          <section class='week-group'>
            <h2 class='week-heading'>
              {week ? `Week ${week}` : 'Unassigned'}
            </h2>
            <ul class='reading-list'>
              {readings
                .filter((reading) => reading.data.week === week)
                .map((reading) => {
                  const files = reading.data.files ?? [];
                  const titleHref = files.length
                    ? withBase(files[0].path)
                    : reading.data.url;
                  return (
                    <li class='reading-entry'>
                      <p class='reading-title'>
                        {titleHref ? (
                          <DashedLink href={titleHref} external>
                            {reading.data.title}
                          </DashedLink>
                        ) : (
                          reading.data.title
                        )}
                      </p>
                      <p class='reading-meta'>
                        {[
                          reading.data.author,
                          reading.data.venue,
                          reading.data.year ? String(reading.data.year) : null,
                        ]
                          .filter(Boolean)
                          .join(' · ')}
                      </p>
                      {reading.data.note && (
                        <p class='reading-note'>{reading.data.note}</p>
                      )}
                      {files.length > 1 && (
                        <p class='reading-files'>
                          {files.map((file, i) => (
                            <>
                              {i > 0 && <span class='file-sep'> · </span>}
                              <DashedLink href={withBase(file.path)} external>
                                {file.label}
                              </DashedLink>
                            </>
                          ))}
                        </p>
                      )}
                      {hasText(reading.body) && (
                        <p class='reading-onsite'>
                          <DashedLink href={withBase(`readings/${reading.id}/`)}>
                            Read on site
                          </DashedLink>
                        </p>
                      )}
                    </li>
                  );
                })}
            </ul>
          </section>
        ))
      }
    </section>
  </main>
</Default>

<style>
  .home-section {
    margin-top: 4rem;
  }

  .page-copy {
    margin-bottom: 2rem;
    opacity: 0.8;
  }

  .week-group {
    margin-top: 2rem;
  }

  .week-heading {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .reading-list {
    display: flex;
    flex-direction: column;
  }

  .reading-entry {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(var(--color-border), 0.55);
  }

  .reading-entry:first-child {
    padding-top: 0;
  }

  .reading-title {
    font-weight: 700;
    line-height: 1.4;
  }

  .reading-meta {
    margin-top: 0.25rem;
    font-size: 0.85rem;
    font-weight: 500;
    opacity: 0.75;
  }

  .reading-note {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    opacity: 0.85;
  }

  .reading-onsite {
    margin-top: 0.375rem;
    font-size: 0.875rem;
  }

  .reading-files {
    margin-top: 0.375rem;
    font-size: 0.875rem;
  }

  .file-sep {
    opacity: 0.5;
  }
</style>
